        // View/Edit expense logic (stub)
        function viewExpense(id) {
            // Load expense details into form, set form to read-only if not editable
        }
        function editExpense(id) {
            // Load expense details into form, allow editing
            // openExpenseModal(expense);
        }
    </script>
</body>
</html>
