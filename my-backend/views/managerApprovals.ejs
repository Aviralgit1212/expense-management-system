<!DOCTYPE html>
<html>
<head>
    <title>Approvals to Review - Manager Dashboard</title>
    <style>
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f3f4f6; margin: 0; padding: 0; }
        .container { max-width: 900px; margin: 32px auto; background: #fff; border-radius: 14px; box-shadow: 0 4px 24px rgba(0,0,0,0.07); padding: 32px 28px 40px 28px; }
        h2 { color: #4f46e5; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        th, td { padding: 12px 10px; border-bottom: 1px solid #e5e7eb; text-align: left; }
        th { background: #f3f4f6; color: #4f46e5; font-weight: 600; }
        .action-btn { background: #4f46e5; color: #fff; border: none; border-radius: 6px; padding: 6px 14px; font-size: 0.95rem; font-weight: 500; cursor: pointer; margin-right: 6px; transition: background 0.2s; }
        .action-btn.reject { background: #ef4444; }
        .action-btn:disabled { background: #d1d5db; color: #888; cursor: not-allowed; }
        .readonly-row { background: #f1f5f9; }
        .status-approved { color: #10b981; font-weight: bold; }
        .status-rejected { color: #ef4444; font-weight: bold; }
        .status-pending { color: #6366f1; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Approvals to Review</h2>
        <table>
            <tr>
                <th>Approval Subject</th>
                <th>Request Owner</th>
                <th>Category</th>
                <th>Request Status</th>
                <th>Total Amount</th>
                <th>Actions</th>
            </tr>
            <% expenses.forEach(e => { %>
            <tr class="<%= e.status !== 'pending' ? 'readonly-row' : '' %>">
                <td><%= e.description || 'none' %></td>
                <td><%= e.owner_name %></td>
                <td><%= e.category %></td>
                <td class="status-<%= e.status %>"><%= e.status.charAt(0).toUpperCase() + e.status.slice(1) %></td>
                <td>
                    $<%= e.amount %>
                    <% if (e.country && e.country !== 'US') { %>
                        (in <%= e.country %>)
                        <!-- You can add currency conversion logic here if needed -->
                    <% } %>
                </td>
                <td>
                    <% if (e.status === 'pending') { %>
                        <form method="POST" action="/expenses/approve/<%= e.id %>" style="display:inline">
                            <button type="submit" class="action-btn">Approve</button>
                        </form>
                        <form method="POST" action="/expenses/reject/<%= e.id %>" style="display:inline">
                            <button type="submit" class="action-btn reject">Reject</button>
                        </form>
                    <% } %>
                </td>
            </tr>
            <% }) %>
        </table>
        <a href="/logout" style="color:#4f46e5;">Logout</a>
    </div>
</body>
</html>
